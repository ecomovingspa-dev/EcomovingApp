{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/marketing",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron-cobranza",
      "schedule": "0 12 * * *"
    }
  ]
}